#!/bin/bash

compiler="${FCC_CLANG:-clang}"
pass="${FCC_PASS_DIR:-@CMAKE_CURRENT_BINARY_DIR@}/libInstrumentationPass.so"
binary_dir="${FCC_BINARY_DIR:-@CMAKE_BINARY_DIR@}"

set -e

# WLLVM had a bug that silently dropped "-fpass-plugin=a.so"
# because it's misclassified as an object file due to .so ending.
# I fixed this and upstreamed it.
# This script depends on that fix.

# -Qunused-arguments so compiler doesn't complain about linker commands being passed
# during compilation.

dopass="-fpass-plugin=$pass"
LLVM_COMPILER=$compiler exec wllvm              \
     -g                                         \
     -fpass-plugin="$pass"                      \
     "$@"                                       \
     -L"$binary_dir"                            \
     -lRuntime                                  \
     -Wl,-rpath,"$binary_dir"                   \
     -Qunused-arguments